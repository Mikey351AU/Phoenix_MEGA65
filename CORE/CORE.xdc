## Name Autogenerated Clocks
## Important: Using them in subsequent statements, e.g. clock dividers requires that they
## have been named/defined here before
## otherwise Vivado does not find the pins)
create_generated_clock -name main_clk      [get_pins CORE/clk_gen/i_clk_main/CLKOUT0]
create_generated_clock -name video_clk     [get_pins CORE/clk_gen/i_clk_main/CLKOUT1]

## main_clk (11 MHz) and video_clk (44 MHz) come from the same MMCM and are phase aligned,
## so the transfer of Phoenix's video signals from main_clk to video_clk (main.vhd) is a
## normal synchronous path and is timed by Vivado. No exceptions needed.
##
## The ROM loader (mega65.vhd) uses xpm_cdc_handshake between qnice_clk and main_clk, which
## brings its own constraints.
